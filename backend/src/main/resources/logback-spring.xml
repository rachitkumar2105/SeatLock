<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- JSON lines on stdout, one request's log lines correlated by "requestId" (see
         RequestCorrelationFilter) — greppable/queryable in any log aggregator without a
         separate log-shipping pipeline to parse plain-text lines. -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <customFields>{"service":"seatlock"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
